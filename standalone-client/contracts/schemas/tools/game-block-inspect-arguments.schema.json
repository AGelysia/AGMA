{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://minecraft-agent.dev/schemas/1.0/tools/game-block-inspect-arguments.schema.json",
  "title": "AGMA Client Block Inspect Arguments",
  "type": "object",
  "additionalProperties": false,
  "maxProperties": 1,
  "properties": {
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z"],
      "properties": {
        "x": { "type": "integer", "minimum": -30000000, "maximum": 30000000 },
        "y": { "type": "integer", "minimum": -2048, "maximum": 2048 },
        "z": { "type": "integer", "minimum": -30000000, "maximum": 30000000 }
      }
    }
  }
}

{
  "name": "agma-runtime",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Local model runtime for AGMA",
  "engines": {
    "node": ">=22.16.0 <23",
    "npm": ">=10"
  },
  "exports": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:standalone",
    "build:standalone": "node scripts/build-standalone.mjs",
    "dev": "npm run build --silent && npm start",
    "start": "node dist/bootstrap/index.js",
    "start:standalone": "node dist-standalone/bootstrap/index.js",
    "validate:provider": "node dist/validation/live-provider-check.js",
    "version": "node scripts/version.mjs",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.test.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run build && npm test"
  },
  "dependencies": {
    "@fastify/websocket": "11.3.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "fastify": "5.10.0",
    "mdast-util-from-markdown": "2.0.2",
    "parse5": "8.0.1",
    "yaml": "2.9.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.2",
    "@types/ws": "8.18.1",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "prettier": "3.9.8",
    "typescript": "7.0.2",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  }
}
